# Database
# For local run without Docker (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./interview_agent.db
# For PostgreSQL (Docker):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interview_agent

# LLM Provider Keys (at least one required for real LLM)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Per-agent LiteLLM model routing
PLANNER_MODEL=openai/gpt-4o-mini
INTERVIEWER_MODEL=openai/gpt-4o
EVALUATOR_MODEL=anthropic/claude-sonnet-4-20250514
REPORT_MODEL=openai/gpt-4o

# Interview settings
MAX_QUESTIONS=10

# Demo / tests: set to 1 to use real LLM providers
USE_REAL_LLM=0

# Logging
LOG_LEVEL=INFO

# LangSmith Observability / Traceability (optional for local, highly recommended for production)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-interview-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

