# Copy to project root or backend before running
# For local run without Docker (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./interview_agent.db
# For PostgreSQL (Docker):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interview_agent

# Enable real LLM calls (1 = True, 0 = False / Mock Mode)
USE_REAL_LLM=1

# Gemini API Key (Gemini models: gemini/gemini-2.0-flash, gemini/gemini-1.5-pro)
GEMINI_API_KEY=your_gemini_api_key_here

# Agent Models
PLANNER_MODEL=gemini/gemini-2.0-flash
INTERVIEWER_MODEL=gemini/gemini-2.0-flash
EVALUATOR_MODEL=gemini/gemini-2.0-flash
REPORT_MODEL=gemini/gemini-2.0-flash

# LangSmith Observability / Traceability (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ai-interview-agent
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com


